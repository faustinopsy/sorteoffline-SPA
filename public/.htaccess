# Faz o Apache servir index.html para qualquer rota da SPA (React Router)
# que não corresponda a um arquivo real — sem isso, acessar uma URL como
# /ferramentas direto (ou dar F5 nela) retorna 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
